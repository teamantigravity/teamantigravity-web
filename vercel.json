{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/finance",
      "destination": "/fintracker",
      "statusCode": 301
    },
    {
      "source": "/privacy/gravityfinance",
      "destination": "/privacy/gravityfintracker",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:css|js|png|svg|jpg|jpeg|webp|gif|ico|woff|woff2|ttf|otf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
